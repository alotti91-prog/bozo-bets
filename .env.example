# Copy this file to .env.local and fill in both values from
# Supabase > Project Settings > API (or "API Keys").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Prop lines (SPORTSGAMEODDS_KEY) only work through /api, which `npm run dev`
# doesn't have, so that key goes in Vercel's Environment Variables, not here.
